{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "books",
	"main": "worker.js",
	"compatibility_date": "2026-08-26",
	"assets": {
		"directory": ".",
		"binding": "ASSETS"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "clickcount",
			"database_id": "9ef814d8-ae06-4858-9378-09e4c57c1e5a"
		}
	],
	"triggers": {
		"crons": [
			"59 17 * * 0"
		]
	}
}