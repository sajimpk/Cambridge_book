{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "free",
	"main": "worker.js",
	"compatibility_date": "2026-08-26",
	"vars": {
		"COUNT_ADMIN_KEY": "sajimpk",
		"API_KEY": "sajimpk"
	},
	"assets": {
		"directory": ".",
		"binding": "ASSETS"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "clickcount",
			"database_id": "0670b08f-17dd-4584-baea-d7f53931a880"
		},
		{
			"binding": "clickcount",
			"database_name": "clickcount",
			"database_id": "0670b08f-17dd-4584-baea-d7f53931a880",
			"remote": true
		}
	],
	"triggers": {
		"crons": [
			"59 17 * * 1"
		]
	}
}