{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "books",
	"main": "worker.js",
	"compatibility_date": "2026-08-26",
	"vars": {
		"COUNT_ADMIN_KEY": "sajimpk",
		"API_KEY": "sajimpk"
	},
	"assets": {
		"directory": ".",
		"binding": "ASSETS"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "clickcount",
			"database_id": "d2481598-7f78-49b9-8a7d-9c70dd7924d7"
		}
	],
	"triggers": {
		"crons": [
			"59 17 * * 1"
		]
	}
}